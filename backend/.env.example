# Copy to .env and fill in values. Never commit real secrets.

# --- Database & cache ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/campus_social
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT — implement later) ---
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- Third-party integrations ---
EMAIL_PROVIDER_KEY=
MODERATION_PROVIDER_KEY=

# --- App ---
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
