# Copy to .env and fill in values. Never commit real secrets.

# Required for FastAPI startup, DB sessions, and Alembic migrations.
# Neon Postgres connections should include sslmode=require.
DATABASE_URL=postgresql+psycopg://NEON_USER:NEON_PASSWORD@YOUR_NEON_HOST/DB_NAME?sslmode=require

# App
APP_ENV=development
APP_NAME=Campus Social API
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for authentication.
JWT_SECRET=change-me-development-access-secret-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
